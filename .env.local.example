# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Владелец платформы (доступ к /dashboard/admin)
PLATFORM_ADMIN_EMAIL=kashebaev@gmail.com

# Anthropic AI (для AI Жанара)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Наименование организации по БИН (/dashboard/check) — хотя бы один источник:
# data.egov.kz → Разработчикам → Кабинет разработчика → API-ключ (в URL: ?apiKey=...)
# Набор данных: gbd_ul (ГБД ЮЛ, Минюст РК)
DATA_EGOV_KZ_API_KEY=
# Или токен Учёт.ПК: https://pk.uchet.kz/docs/reference/full_info_bin.html
UCHET_PK_API_TOKEN=

# Подтверждение email (только если в Supabase включён Confirm email)
# Пока выключено — не добавляйте или оставьте false
# NEXT_PUBLIC_REQUIRE_EMAIL_CONFIRMATION=true

# Apipay / Kaspi (оплата подписки)
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
